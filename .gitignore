.ninja_log
build.ninja
rules.ninja

# Local, unredacted hardware dump — contains per-unit identifiers
# (power-adapter serial, battery calibration blobs). Never commit this.
tools/smc_dump.local.txt
*.local.txt

# User settings written at runtime
config.ini

