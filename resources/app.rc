#include <windows.h>

// Embed the side-by-side manifest (RT_MANIFEST = 24, CREATEPROCESS_MANIFEST_RESOURCE_ID = 1)
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,2,0,0
PRODUCTVERSION  1,2,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "MacFanCtl - Mac fan and temperature control"
            VALUE "FileVersion",     "1.2.0.0"
            VALUE "InternalName",    "MacFanCtl"
            VALUE "OriginalFilename","MacFanCtl.exe"
            VALUE "ProductName",     "MacFanCtl"
            VALUE "ProductVersion",  "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
