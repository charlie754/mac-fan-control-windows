#include <windows.h>
#include "..\src\version.h"

// Embed the side-by-side manifest (RT_MANIFEST = 24, CREATEPROCESS_MANIFEST_RESOURCE_ID = 1)
1 24 "app.manifest"

// The built-in online model's iPhone mockup.
GOATCAM_IPHONE RCDATA "goatcam-iphone.png"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     MACFANCTL_VERSION_MAJOR,MACFANCTL_VERSION_MINOR,MACFANCTL_VERSION_PATCH,0
PRODUCTVERSION  MACFANCTL_VERSION_MAJOR,MACFANCTL_VERSION_MINOR,MACFANCTL_VERSION_PATCH,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "MacFanCtl - Mac fan and temperature control"
            VALUE "FileVersion",     MACFANCTL_VERSION ".0"
            VALUE "InternalName",    "MacFanCtl"
            VALUE "OriginalFilename","MacFanCtl.exe"
            VALUE "ProductName",     "MacFanCtl"
            VALUE "ProductVersion",  MACFANCTL_VERSION ".0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
